{
  "name": "meshcore-mapper",
  "version": "1.0.0",
  "description": "LoRa Signal Propagation Mapper",
  "main": "./out/main/index.js",
  "scripts": {
    "app": "powershell -ExecutionPolicy Bypass -File ./start-app.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File ./start-app.ps1 -NoLaunch",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "syntax": "node scripts/check-syntax.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run tests/unit",
    "smoke": "electron-vite build && playwright test tests/smoke",
    "check": "npm run syntax && npm run lint && npm run typecheck && npm run test && npm audit --omit=dev && npm run smoke",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "com.meshcore.mapper",
    "productName": "MeshCore Mapper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "vendor/**/*",
      "presets.yaml",
      "style.css",
      "scripts/cuda_coverage.py",
      "scripts/meshcore_cuda/**/*"
    ],
    "asarUnpack": [
      "scripts/cuda_coverage.py",
      "scripts/meshcore_cuda/**/*"
    ],
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "sql.js": "^1.10.3",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/three": "^0.184.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
